# Copy to .env and fill in. .env is git-ignored.

# ---------- Supabase ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_REST_ENDPOINT=https://<project-ref>.supabase.co/rest/v1
SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1
SUPABASE_TABLE_READINGS=sensor_readings
SUPABASE_TABLE_CAPTURES=camera_captures
SUPABASE_BUCKET=rover_images

# ---------- The boards (rover + camera) ----------
# After editing this part, run:  python -m earth_station.secrets
# It writes rover1/secrets.h and cam1/secrets.h from these values, so both boards
# always join the same network, and it makes ROVER_CMD_TOKEN for you.

# Your phone hotspot: the rover, the camera and the laptop all join it.
# Use the 2.4 GHz band: ESP32 boards can't see 5 GHz WiFi.
WIFI_SSID=
WIFI_PASS=

# Each board's own WiFi (AP) for its control page at 192.168.4.1.
# The password is what you type on your phone to join it (8+ characters).
ROVER_AP_SSID=ESP32-Car-AP
ROVER_AP_PASS=
CAM_AP_SSID=ESP32_CAM_MARS
CAM_AP_PASS=

# =====================================================================
# Earth Station (laptop). Defaults below work with the simulator:
#   python -m earth_station --sim
# =====================================================================

# Board addresses. Leave them empty: the Earth Station finds the boards itself
# (a simulator on this laptop, then rover.local / cam.local, then a scan of the hotspot).
# Only fill one in if it can't be found, with the IP address the board prints on its
# Serial monitor at boot, e.g. http://172.20.10.3. The camera needs firmware 2.1 or
# newer to be found by name or scan. --sim ignores both.
ROVER_URL=
CAMERA_URL=
# Shared secret for /jev/cmd. `python -m earth_station.secrets` replaces sim-token
# with a long random value and writes the same one into rover1/secrets.h.
ROVER_CMD_TOKEN=sim-token

# Jev: "mock" (offline stand-in) or "live" (TypeSafe API)
# Get a key at https://console.typesafe.ai/keys, then set JEV_MODE=live
JEV_MODE=mock
JEV_API_KEY=
# Most real Jev calls in one run (spending guard). The run stops the rover and ends
# after this many. 20 is about 10 seconds of driving; raise it for longer runs.
JEV_MAX_CALLS=20
# Usually leave these as they are
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Photo descriptions: "mock" (offline stand-in) or "live" (a vision AI describes
# each photo for Jev). The provider is Gemini or Anthropic (Claude):
#   gemini:    a free key from https://aistudio.google.com (no credit card)
#   anthropic: a paid key from https://console.anthropic.com
DESCRIBE_MODE=mock
VISION_PROVIDER=gemini
VISION_API_KEY=
# The model, per provider:
#   gemini:    gemini-flash-lite-latest always points at the newest small Gemini
#   anthropic: claude-opus-5-5
VISION_MODEL=gemini-flash-lite-latest
# Objects the vision AI should watch out for (comma-separated; empty = generic).
# Jev reads the description, so say the things the rover must never miss.
VISION_FOCUS=cables on the floor, stairs or drops, furniture corners, pet or person's feet
# Used by anthropic only (how hard Claude thinks; low is quickest and cheapest)
VISION_EFFORT=low
VISION_TIMEOUT_S=10

# Timing (milliseconds)
TELEMETRY_EVERY_MS=200
# Camera: describe takes ~2.5 s inside the loop, so the real photo period is
# CAMERA_EVERY_MS + 2.5 s. 3000 lands on a ~5.5 s period = ~11 requests/minute,
# which the free Gemini tier allows (Flash-Lite: ~15 RPM). It must stay below
# SCENE_MAX_AGE_MS, or the safety gate stops for "camera description too old".
CAMERA_EVERY_MS=3000
DECIDE_EVERY_MS=500

# Safety
MIN_CONFIDENCE=0.60
BLOCKED_THRESHOLD=0.70
MAX_SPEED=170
MOVE_MS=300
SAFE_DISTANCE_CM=40
TELEMETRY_MAX_AGE_MS=500
# Scene: the newest description is trusted for this long. Keep it longer than
# the real photo period (CAMERA_EVERY_MS + describe time ~= 5.5 s), else the
# gate stops too often; but short enough that Jev never drives on a very old view.
SCENE_MAX_AGE_MS=6500

GOAL=explore the room safely

# Mission control: the page that opens in your browser, at http://127.0.0.1:8000
# Change the number only if another program already uses port 8000.
MISSION_CONTROL_PORT=8000
