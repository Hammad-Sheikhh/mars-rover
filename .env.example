# Copy to .env and fill in. .env is git-ignored.

# ---------- Supabase ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_REST_ENDPOINT=https://<project-ref>.supabase.co/rest/v1
SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1
SUPABASE_TABLE_READINGS=sensor_readings
SUPABASE_TABLE_CAPTURES=camera_captures
SUPABASE_BUCKET=rover_images

# ---------- The boards (rover + camera) ----------
# After editing this part, run:  python -m earth_station.secrets
# It writes rover1/secrets.h and cam1/secrets.h from these values, so both boards
# always join the same network, and it makes ROVER_CMD_TOKEN for you.

# Your phone hotspot: the rover, the camera and the laptop all join it.
# Use the 2.4 GHz band: ESP32 boards can't see 5 GHz WiFi.
WIFI_SSID=
WIFI_PASS=

# Each board's own WiFi (AP) for its control page at 192.168.4.1.
# The password is what you type on your phone to join it (8+ characters).
ROVER_AP_SSID=ESP32-Car-AP
ROVER_AP_PASS=
CAM_AP_SSID=ESP32_CAM_MARS
CAM_AP_PASS=

# =====================================================================
# Earth Station (laptop). Defaults below work with the simulator:
#   python -m earth_station --sim
# =====================================================================

# Board addresses on the hotspot. --sim ignores these and uses the fake rover.
# The rover announces rover.local. The camera doesn't have a name yet (milestone 4):
# use the IP address it prints on its Serial monitor at boot, e.g. http://172.20.10.3
ROVER_URL=http://rover.local
CAMERA_URL=http://127.0.0.1:8082
# Shared secret for /jev/cmd. `python -m earth_station.secrets` replaces sim-token
# with a long random value and writes the same one into rover1/secrets.h.
ROVER_CMD_TOKEN=sim-token

# Jev: "mock" (offline stand-in) or "live" (TypeSafe API)
# Get a key at https://console.typesafe.ai/keys, then set JEV_MODE=live
JEV_MODE=mock
JEV_API_KEY=
# Usually leave these as they are
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Photo descriptions: "mock" or "live" (teammate's vision model)
DESCRIBE_MODE=mock
VISION_API_KEY=

# Timing (milliseconds)
TELEMETRY_EVERY_MS=200
CAMERA_EVERY_MS=1500
DECIDE_EVERY_MS=500

# Safety
MIN_CONFIDENCE=0.60
BLOCKED_THRESHOLD=0.70
MAX_SPEED=170
MOVE_MS=300
SAFE_DISTANCE_CM=40
TELEMETRY_MAX_AGE_MS=500
SCENE_MAX_AGE_MS=3000

GOAL=explore the room safely
