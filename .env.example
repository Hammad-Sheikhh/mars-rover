# Copy to .env and fill in. .env is git-ignored.

# ---------- Supabase ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_REST_ENDPOINT=https://<project-ref>.supabase.co/rest/v1
SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1
SUPABASE_TABLE_READINGS=sensor_readings
SUPABASE_TABLE_CAPTURES=camera_captures
SUPABASE_BUCKET=rover_images

# ---------- Rover (ESP32) ----------
ROVER_WIFI_SSID=
ROVER_WIFI_PASS=
ROVER_AP_SSID=ESP32-Car-AP
ROVER_AP_PASS=

# ---------- Camera (ESP32-CAM) ----------
CAM_WIFI_SSID=
CAM_WIFI_PASS=
CAM_AP_SSID=ESP32_CAM_MARS
CAM_AP_PASS=

# =====================================================================
# Earth Station (laptop). Defaults below work with the simulator:
#   python -m earth_station --sim
# =====================================================================

# Board addresses on the shared router (see the Serial monitor at boot)
ROVER_URL=http://127.0.0.1:8081
CAMERA_URL=http://127.0.0.1:8082
# Shared secret for /jev/cmd. Must equal ROVER_CMD_TOKEN in rover1/secrets.h
ROVER_CMD_TOKEN=sim-token

# Jev: "mock" (offline stand-in) or "live" (Typesafe API)
JEV_MODE=mock
JEV_API_URL=
JEV_API_KEY=

# Photo descriptions: "mock" or "live" (teammate's vision model)
DESCRIBE_MODE=mock
VISION_API_KEY=

# Timing (milliseconds)
TELEMETRY_EVERY_MS=200
CAMERA_EVERY_MS=1500
DECIDE_EVERY_MS=500

# Safety
MIN_CONFIDENCE=0.60
BLOCKED_THRESHOLD=0.70
MAX_SPEED=170
MOVE_MS=300
SAFE_DISTANCE_CM=40
TELEMETRY_MAX_AGE_MS=500
SCENE_MAX_AGE_MS=3000

GOAL=explore the room safely
